// Copy this file to secrets.local.js (same directory) and fill in real
// values for local testing with `npx serve .`. secrets.local.js matches
// the repo's *secret* .gitignore pattern, so it's never committed and
// never gets picked up by ares-package either (see the --app-exclude
// flags in README.md and the GitHub Action).
//
// In a real deploy via the GitHub Action, this file doesn't exist at
// all — the Action substitutes the same values directly into app.js
// from repo secrets instead. This file only matters for local testing.
window.APP_CONFIG = {
  // Base URL of the deployed Next.js web app (tv-handoff/tv-poll/tv-login).
  WEBAPP_URL: "https://your-webapp.vercel.app",

  // Same Supabase project as the web app. The anon key is meant to be
  // public/embedded client-side — RLS policies on wa/hashes (scoped to
  // the allowed account) are what actually protect the data, same
  // model as photo-match-next.
  SUPABASE_URL: "https://your-project.supabase.co",
  SUPABASE_ANON_KEY: "your-anon-key",

  // Local HTTP server serving the actual photo bytes, e.g. a small
  // static file server on a machine on the home network.
  PHOTO_SERVER_URL: "http://192.168.1.50:8080",
};

// Copy this file to secrets.local.js (same directory) and fill in real
// values for local testing with `npx serve .`. secrets.local.js matches
// the repo's *secret* .gitignore pattern, so it's never committed and
// never gets picked up by ares-package either (see the --app-exclude
// flags in README.md and the GitHub Action).
//
// In a real deploy via the GitHub Action, this file doesn't exist at
// all — the Action substitutes the same values directly into app.js
// from repo secrets instead. This file only matters for local testing.
window.APP_CONFIG = {
  PAIRING_BACKEND_URL: "https://your-pairing-backend.vercel.app",
  PAIRING_SHARED_SECRET: "match-this-to-the-backend's-PAIRING_SHARED_SECRET-env-var",
};

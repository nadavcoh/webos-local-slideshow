# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Single-user allowlist: the owner's GitHub user id (optional; this is the default).
# Replaces the old ALLOWED_EMAIL, which is no longer read.
ALLOWED_GITHUB_ID=29537286

# Auto-injected by attaching a Vercel KV database to this project —
# you shouldn't need to set these by hand, just attach the database.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
